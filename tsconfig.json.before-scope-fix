{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext",
                                        "webworker"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ],
                                          "@config":  [
                                                          "./yuktai.config.ts"
                                                      ]
                                      },
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "include":  [
                    "next-env.d.ts",
                    "next-pwa.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    "**/*.mts",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "rust",
                    "public/sw.js"
                ]
}
